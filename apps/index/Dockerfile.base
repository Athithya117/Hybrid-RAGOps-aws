# Dockerfile.base
# Build a pinned, reproducible "base" image containing:
# - runtime apt packages required by conversion tools
# - a deterministic Python venv at /opt/venv with wheels installed
# - large ML artifacts (faster-whisper, spaCy model)
#
# Usage: docker build -f Dockerfile.base -t YOUR_REGISTRY_OR_USER/indexing-base:2026-01-10 .

# ---------------- BUILDER STAGE ----------------
FROM ubuntu:22.04 AS builder
ENV DEBIAN_FRONTEND=noninteractive
ENV VENV_PATH=/opt/venv
ENV PYTHONUNBUFFERED=1
ENV PATH=${VENV_PATH}/bin:$PATH

# Build dependencies for wheels
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    build-essential gcc g++ clang libclang-dev git git-lfs curl wget ca-certificates pkg-config \
    python3-dev python3-venv python3-distutils libssl-dev libffi-dev libbz2-dev liblzma-dev libsndfile1 \
    libjpeg-dev zlib1g-dev libxml2-dev libxslt-dev libpng-dev libfreetype6-dev \
    libharfbuzz-dev libxcb1-dev libx11-dev libxext-dev libxrender-dev libfontconfig1-dev \
    libopenjp2-7-dev libleptonica-dev libtesseract-dev poppler-utils libmagic1 tesseract-ocr \
 && rm -rf /var/lib/apt/lists/*

# Ensure /usr/bin/python exists for tooling that expects 'python'
RUN ln -s /usr/bin/python3 /usr/bin/python || true

WORKDIR /src
COPY requirements.txt /src/requirements.txt
# Create venv and wheel cache
RUN python3 -m venv ${VENV_PATH} \
 && ${VENV_PATH}/bin/pip install --upgrade pip setuptools wheel \
 && mkdir -p /wheels \
 && ${VENV_PATH}/bin/pip wheel -r /src/requirements.txt -w /wheels

# Install app runtime deps into venv from wheels (deterministic)
RUN ${VENV_PATH}/bin/pip install --no-index --find-links=/wheels -r /src/requirements.txt

# Also install pinned Azure & HF helpers deterministically
RUN ${VENV_PATH}/bin/pip install --no-cache-dir \
    azure-storage-blob==12.24.0 \
    azure-identity==1.15.0 \
    huggingface_hub==0.17.0

# Download Faster-Whisper and spaCy model into a predictable path under /models
RUN mkdir -p /models/faster_whisper/faster-whisper-base
RUN ${VENV_PATH}/bin/python - <<'PY'
from huggingface_hub import hf_hub_download
from pathlib import Path
import shutil, os, sys
files = ["model.bin","config.json","tokenizer.json","vocabulary.txt","README.md"]
base = Path("/models/faster_whisper/faster-whisper-base")
base.mkdir(parents=True, exist_ok=True)
tmp = Path("/tmp/hf"); tmp.mkdir(parents=True, exist_ok=True)
failed = False
for f in files:
    try:
        src = hf_hub_download("Systran/faster-whisper-base", f, local_dir=str(tmp), local_dir_use_symlinks=False)
        dest = base / f
        if dest.exists():
            try: dest.unlink()
            except Exception: pass
        shutil.move(src, dest)
        try: os.chmod(str(dest), 0o444)
        except Exception: pass
    except Exception as e:
        print("FAILED DOWNLOAD:", f, e, file=sys.stderr)
        failed = True
if failed:
    sys.exit(2)
PY

# Download spaCy model (target into /models/spacy)
RUN mkdir -p /models/spacy
RUN ${VENV_PATH}/bin/python -m spacy download en_core_web_sm --target /models/spacy

# ---------------- FINAL / RUNTIME IMAGE ----------------
FROM ubuntu:22.04 AS base
LABEL org.opencontainers.image.title="indexing-base"
LABEL org.opencontainers.image.version="2026-01-10"

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV VENV_PATH=/opt/venv
ENV PATH=${VENV_PATH}/bin:$PATH

# Runtime packages required for conversion tools and OCR; keep minimal but complete
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates wget curl gnupg2 dirmngr lsb-release \
    software-properties-common \
    fonts-dejavu-core tini unzip jq util-linux \
    libmagic1 poppler-utils ffmpeg sox libsndfile1 \
    libgl1 libgl1-mesa-dri libglib2.0-0 libsm6 libxrender1 libxext6 \
    tesseract-ocr default-jre-headless libreoffice libreoffice-writer libreoffice-common libreoffice-core \
    fonts-dejavu fonts-liberation \
 && rm -rf /var/lib/apt/lists/*

# Copy deterministic venv and models from builder
COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /models /models

# Make sure /usr/bin/python exists
RUN ln -s /usr/bin/python3 /usr/bin/python || true

# Placeholders & defaults: these are conservative defaults appropriate for runtime.
ENV TMP_ROOT=/tmp/preconv
ENV DESIRED_NOFILE=262144
ENV MAX_PARALLEL_CONVERTS=2
ENV FDS_PER_CONVERT=60
ENV PATH=${VENV_PATH}/bin:$PATH
ENV PYTHONPATH=/indexing_pipeline

# Create TMP_ROOT and set sticky bit for random tmp dirs
RUN mkdir -p ${TMP_ROOT} && chown root:root ${TMP_ROOT} && chmod 1777 ${TMP_ROOT}

WORKDIR /indexing_pipeline

# Keep image small-ish: clear apt caches (already removed) and ensure venv ownership / perms
RUN chmod -R a+rX /opt/venv || true && chmod -R a+rX /models || true

# Final image exposes only the built runtime; app code will be copied in application Dockerfile
